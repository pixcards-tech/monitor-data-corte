# Configurações gerais
STORAGE_PATH=data
HEADLESS=False
TIMEOUT_MS=180000
CHROME_CHANNEL=chrome

# ─────────────────────────────────────────────────────
# Backend de persistência
#   STORAGE_BACKEND=file      → JSON/JSONL em STORAGE_PATH (default, sem Docker)
#   STORAGE_BACKEND=postgres  → PostgreSQL (exige DATABASE_URL)
# ─────────────────────────────────────────────────────
STORAGE_BACKEND=file
# DATABASE_URL=postgresql+psycopg://monitor:monitor@db:5432/monitor

# PostgreSQL (usado pelo docker-compose)
POSTGRES_USER=monitor
POSTGRES_PASSWORD=monitor
POSTGRES_DB=monitor

# Serviço runner no Docker: RUN_ON_START=true → coleta imediata no boot
RUN_ON_START=false

# Certificado de cliente (mTLS) do ConsigFácil — só para rodar no Docker/Linux.
# Coloque o arquivo exportado (.p12/.pfx, com a chave privada) em secrets/consigfacil.p12
# e informe aqui a senha de exportação do certificado.
CERT_PASSWORD=

# Nota p/ container: CHROME_CHANNEL=chrome + HEADLESS=True (definidos no compose)

# SMTP para notificações
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
NOTIFICACAO_DESTINATARIOS=

# Agendamento (formato HH:MM — vazio = desabilitado)
COLETA_HORARIO=

# Auth do painel/API (HTTP Basic). PANEL_PASSWORD vazio = SEM auth (aberto);
# setar a senha (gerada na VM) liga a proteção de leitura + escrita.
PANEL_USER=admin
PANEL_PASSWORD=

# Webhooks de mudança de data de corte (URLs separadas por vírgula; vazio = desabilitado)
WEBHOOK_URLS=

# Dead-man's switch: URL de uptime (ex.: https://hc-ping.com/<uuid>) pingada ao fim de cada coleta
HEALTHCHECK_URL=

# Alerta operacional com severidade (ex.: Slack incoming webhook) ao fim de cada coleta; vazio = off
ALERT_WEBHOOK_URL=

# ─────────────────────────────────────────────────────
# Credenciais dos portais
# Padrão: {PORTAL}_{CONVENIO_KEY}_USERNAME / _PASSWORD
# ─────────────────────────────────────────────────────

# Portal ConsigUp — Muaná
CONSIGUP_MUANA_USERNAME=
CONSIGUP_MUANA_PASSWORD=

# Portal ConSIGI — Contagem
CONSIGI_CONTAGEM_USERNAME=
CONSIGI_CONTAGEM_PASSWORD=

# Portal PBConsig (Keycloak) — Paraíba
PBCONSIG_PARAIBA_USERNAME=
PBCONSIG_PARAIBA_PASSWORD=

# Portal Konexia — Planaltina
KONEXIA_PLANALTINA_USERNAME=
KONEXIA_PLANALTINA_PASSWORD=

# Portal ProConsig — Guarulhos
PROCONSIG_GUARULHOS_USERNAME=
PROCONSIG_GUARULHOS_PASSWORD=

# Portal ConsigLog (SAEC)
CONSIGLOG_COTIA_SP_USERNAME=
CONSIGLOG_COTIA_SP_PASSWORD=
CONSIGLOG_DUQUE_DE_CAXIAS_RJ_USERNAME=
CONSIGLOG_DUQUE_DE_CAXIAS_RJ_PASSWORD=

# Portal Fasitec (SICON) — Pilar
FASITEC_PILAR_USERNAME=
FASITEC_PILAR_PASSWORD=

# Portal DigitalConsig
DIGITALCONSIG_VARZEA_GRANDE_USERNAME=
DIGITALCONSIG_VARZEA_GRANDE_PASSWORD=
DIGITALCONSIG_VERA_USERNAME=
DIGITALCONSIG_VERA_PASSWORD=

# SafeConsig — HML (API REST)
SAFECONSIG_HML_BASE_URL=https://modelo.safeconsig.com.br/ws/rest
SAFECONSIG_HML_ID_CONVENIO=60
SAFECONSIG_HML_USERNAME=seu_usuario_aqui
SAFECONSIG_HML_PASSWORD=sua_senha_aqui

# SafeConsig — Produção — São João dos Patos
SAFECONSIG_PROD_SAOJOAODOSPATOS_BASE_URL=https://saojoaodospatos.safeconsig.com.br/ws/rest
SAFECONSIG_PROD_SAOJOAODOSPATOS_ID_CONVENIO=252
SAFECONSIG_PROD_SAOJOAODOSPATOS_USERNAME=api_pixcard
SAFECONSIG_PROD_SAOJOAODOSPATOS_PASSWORD=sua_senha_aqui

# SafeConsig — Produção — Ceará — futuro
# SAFECONSIG_PROD_CEARA_BASE_URL=
# SAFECONSIG_PROD_CEARA_ID_CONVENIO=
# SAFECONSIG_PROD_CEARA_USERNAME=
# SAFECONSIG_PROD_CEARA_PASSWORD=

# SafeConsig — HML (teste) — Uruoca
SAFECONSIG_HML_URUOCA_BASE_URL=https://uruoca.safeconsig.com.br/ws/rest
SAFECONSIG_HML_URUOCA_ID_CONVENIO=257
SAFECONSIG_HML_URUOCA_USERNAME=api_teste_px
SAFECONSIG_HML_URUOCA_PASSWORD=sua_senha_aqui

# SafeConsig — HML (teste) — Itaquaquecetuba
SAFECONSIG_HML_ITAQUAQUECETUBA_BASE_URL=https://itaquaquecetuba.safeconsig.com.br/ws/rest
SAFECONSIG_HML_ITAQUAQUECETUBA_ID_CONVENIO=613
SAFECONSIG_HML_ITAQUAQUECETUBA_USERNAME=api_teste_px
SAFECONSIG_HML_ITAQUAQUECETUBA_PASSWORD=sua_senha_aqui

# SafeConsig — Produção — Santos — futuro
# SAFECONSIG_PROD_SANTOS_BASE_URL=
# SAFECONSIG_PROD_SANTOS_ID_CONVENIO=
# SAFECONSIG_PROD_SANTOS_USERNAME=
# SAFECONSIG_PROD_SANTOS_PASSWORD=

# Portal ConsigNet
CONSIGNET_DEFENSORIA_USERNAME=
CONSIGNET_DEFENSORIA_PASSWORD=
CONSIGNET_MARINGA_USERNAME=
CONSIGNET_MARINGA_PASSWORD=
CONSIGNET_MARINGA_PREV_USERNAME=
CONSIGNET_MARINGA_PREV_PASSWORD=
CONSIGNET_NAVEGANTES_USERNAME=
CONSIGNET_NAVEGANTES_PASSWORD=
CONSIGNET_RANCHARIA_USERNAME=
CONSIGNET_RANCHARIA_PASSWORD=
CONSIGNET_VILHENA_USERNAME=
CONSIGNET_VILHENA_PASSWORD=

# Zetra/eConsig — Centralizador (API SOAP). Credencial única para todos os
# convênios PIX_CARD-*; os convênios ficam em app/core/processadoras.json.
ZETRA_ENDPOINT=https://api.econsig.com.br/central/services/HostaHostService
ZETRA_CLIENTE=PIX_CARD
ZETRA_USUARIO=pix_card_xml
ZETRA_SENHA=
ZETRA_TIMEOUT=30
ZETRA_PAUSA_ENTRE_CHAMADAS=1.5
